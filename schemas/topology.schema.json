{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "rejected"
      ],
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "source": {
      "enum": [
        "manual_reference",
        "model_generated"
      ],
      "type": "string"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "kind": {
            "enum": [
              "router",
              "switch",
              "l3_switch",
              "pc",
              "server"
            ],
            "type": "string"
          },
          "model": {
            "enum": [
              "2911",
              "1941",
              "2960-24TT",
              "3560-24PS",
              "PC-PT",
              "Server-PT"
            ],
            "type": "string"
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?:GigabitEthernet\\d+/\\d+|FastEthernet\\d+(?:/\\d+)?|Serial\\d+/\\d+/\\d+|Vlan\\d+|Loopback\\d+)(?:\\.\\d+)?$"
                },
                "mode": {
                  "enum": [
                    "routed",
                    "access",
                    "trunk",
                    "svi",
                    "subinterface"
                  ],
                  "type": "string"
                },
                "ipv4": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                },
                "vlan": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4094
                },
                "allowed_vlans": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4094
                  },
                  "minItems": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "clock_rate": {
                  "type": "integer",
                  "minimum": 1200,
                  "maximum": 8000000
                },
                "ospf_cost": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "name",
                "mode"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "enum": [
                          "access",
                          "svi",
                          "subinterface"
                        ],
                        "type": "string"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "vlan"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "enum": [
                          "trunk"
                        ],
                        "type": "string"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "allowed_vlans"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "enum": [
                          "access",
                          "trunk"
                        ],
                        "type": "string"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "ipv4"
                      ]
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "gateway": {
            "type": "string",
            "format": "ipv4"
          },
          "vlans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4094
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "routing": {
            "type": "object",
            "properties": {
              "rip": {
                "type": "object",
                "properties": {
                  "version": {
                    "enum": [
                      1,
                      2
                    ],
                    "type": "integer"
                  },
                  "auto_summary": {
                    "type": "boolean"
                  },
                  "networks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "version",
                  "auto_summary",
                  "networks"
                ],
                "additionalProperties": false
              },
              "ospf": {
                "type": "object",
                "properties": {
                  "process_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "router_id": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "networks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "prefix": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                        },
                        "area": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        }
                      },
                      "required": [
                        "prefix",
                        "area"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "process_id",
                  "networks"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "static_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prefix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                },
                "next_hop": {
                  "type": "string",
                  "format": "ipv4"
                },
                "distance": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 254
                }
              },
              "required": [
                "prefix",
                "next_hop"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "acls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 199
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "enum": [
                          "permit",
                          "deny"
                        ],
                        "type": "string"
                      },
                      "protocol": {
                        "enum": [
                          "ip",
                          "icmp",
                          "tcp",
                          "udp"
                        ],
                        "type": "string"
                      },
                      "source": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500,
                            "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                          },
                          {
                            "const": "any"
                          }
                        ]
                      },
                      "destination": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500,
                            "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
                          },
                          {
                            "const": "any"
                          }
                        ]
                      },
                      "destination_port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    },
                    "required": [
                      "action",
                      "protocol",
                      "source",
                      "destination"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "interface": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?:GigabitEthernet\\d+/\\d+|FastEthernet\\d+(?:/\\d+)?|Serial\\d+/\\d+/\\d+|Vlan\\d+|Loopback\\d+)(?:\\.\\d+)?$"
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "number",
                "rules",
                "interface",
                "direction"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "services": {
            "type": "array",
            "items": {
              "enum": [
                "http"
              ],
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "name",
          "kind",
          "model",
          "interfaces"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "interface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?:GigabitEthernet\\d+/\\d+|FastEthernet\\d+(?:/\\d+)?|Serial\\d+/\\d+/\\d+|Vlan\\d+|Loopback\\d+)(?:\\.\\d+)?$"
              }
            },
            "required": [
              "device",
              "interface"
            ],
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "interface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?:GigabitEthernet\\d+/\\d+|FastEthernet\\d+(?:/\\d+)?|Serial\\d+/\\d+/\\d+|Vlan\\d+|Loopback\\d+)(?:\\.\\d+)?$"
              }
            },
            "required": [
              "device",
              "interface"
            ],
            "additionalProperties": false
          },
          "medium": {
            "enum": [
              "copper",
              "serial"
            ],
            "type": "string"
          }
        },
        "required": [
          "a",
          "b",
          "medium"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "ping"
              },
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "target": {
                "type": "string",
                "format": "ipv4"
              },
              "expected": {
                "type": "boolean"
              },
              "min_success_percent": {
                "const": 100
              }
            },
            "required": [
              "id",
              "type",
              "device",
              "target",
              "expected"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "trace"
              },
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "target": {
                "type": "string",
                "format": "ipv4"
              },
              "via": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "ipv4"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "type",
              "device",
              "target",
              "via"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "route"
              },
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
              },
              "prefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
              },
              "protocol": {
                "enum": [
                  "C",
                  "L",
                  "S",
                  "R",
                  "O",
                  "O IA",
                  "B"
                ],
                "type": "string"
              },
              "next_hops": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "ipv4"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "type",
              "device",
              "prefix",
              "protocol"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "name",
    "source",
    "intent"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Packet Tracer topology DSL 1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "required": [
          "devices",
          "links",
          "checks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "required": [
          "questions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
